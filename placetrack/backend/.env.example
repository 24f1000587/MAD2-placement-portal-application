# Copy this file to .env and adjust values as needed.
# None of these need real/secret values to run the demo locally.

# --- Core Flask ---
SECRET_KEY=placetrack-dev-secret-change-me
JWT_SECRET_KEY=placetrack-jwt-secret-change-me
FLASK_ENV=development
FLASK_DEBUG=1

# --- Database ---
# SQLite file is created automatically inside instance/
DATABASE_URL=sqlite:///placetrack.db

# --- Redis (caching + Celery broker/backend) ---
REDIS_URL=redis://localhost:6379/0
CACHE_REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3

# --- Pre-seeded Admin account (created automatically on first run) ---
ADMIN_NAME=Placement Cell Admin
ADMIN_EMAIL=admin@placetrack.edu
ADMIN_PASSWORD=Admin@1234

# --- Notifications ---
# Leave GCHAT_WEBHOOK_URL empty to fall back to a local notification log
# (backend/instance/notifications.log) which is perfect for demos/vivas.
GCHAT_WEBHOOK_URL=

# Optional: SMTP settings if you want real emails for the monthly report.
# Leave MAIL_SERVER empty to fall back to saving the report to disk + log.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=placetrack@institute.edu
